# Contentstack Content Delivery API (editorial editions and articles)
CONTENTSTACK_API_KEY=
CONTENTSTACK_DELIVERY_TOKEN=
CONTENTSTACK_ENVIRONMENT=production
CONTENTSTACK_LOCALE=fr-fr
# Leave blank to use the North America endpoint (cdn.contentstack.io).
CONTENTSTACK_API_HOST=cdn.contentstack.io
# CMA host for importing content (api.contentstack.io for North America, eu-api.contentstack.com for Europe).
CONTENTSTACK_CMA_HOST=api.contentstack.io
# Required only for the one-time Contentstack import script; keep it server-side.
CONTENTSTACK_MANAGEMENT_TOKEN=
# Local first-edition preview is enabled in development unless set to false.
JOURNAL_USE_LOCAL_SEED=true
