{
  "title": "Event",
  "uid": "event",
  "description": "An event entry that can be referenced by an editorial article.",
  "schema": [
    {
      "display_name": "Title",
      "uid": "title",
      "data_type": "text",
      "mandatory": true,
      "unique": true,
      "field_metadata": {
        "_default": true
      },
      "multiple": false
    },
    {
      "display_name": "Slug",
      "uid": "slug",
      "data_type": "text",
      "mandatory": true,
      "unique": true,
      "field_metadata": {},
      "multiple": false
    },
    {
      "display_name": "Starts at",
      "uid": "starts_at",
      "data_type": "isodate",
      "startDate": null,
      "endDate": null,
      "field_metadata": {
        "default_value": ""
      },
      "multiple": false,
      "mandatory": true,
      "unique": false
    },
    {
      "display_name": "Ends at",
      "uid": "ends_at",
      "data_type": "isodate",
      "startDate": null,
      "endDate": null,
      "field_metadata": {
        "default_value": ""
      },
      "multiple": false,
      "mandatory": false,
      "unique": false
    },
    {
      "display_name": "Location",
      "uid": "location",
      "data_type": "text",
      "mandatory": true,
      "unique": false,
      "field_metadata": {},
      "multiple": false
    },
    {
      "display_name": "Description",
      "uid": "description",
      "data_type": "json",
      "field_metadata": {
        "allow_json_rte": true,
        "rich_text_type": "custom",
        "default_value": "",
        "options": [
          "h2",
          "h3",
          "bold",
          "italic",
          "underline",
          "blockquote",
          "lists",
          "link",
          "imagemanager"
        ]
      },
      "reference_to": [
        "article"
      ],
      "non_localizable": false,
      "multiple": false,
      "mandatory": false,
      "unique": false
    },
    {
      "display_name": "Image",
      "uid": "image",
      "data_type": "file",
      "extensions": [
        "jpg",
        "jpeg",
        "png",
        "webp"
      ],
      "field_metadata": {
        "rich_text_type": "standard"
      },
      "multiple": false,
      "mandatory": false,
      "unique": false
    },
    {
      "display_name": "Registration URL",
      "uid": "registration_url",
      "data_type": "text",
      "mandatory": false,
      "unique": false,
      "field_metadata": {},
      "multiple": false
    }
  ],
  "options": {
    "is_page": false,
    "singleton": false,
    "title": "title",
    "sub_title": []
  }
}
